datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
}

model Group {
  id                 String        @id @default(uuid())
  slug               String        @unique
  name               String
  description        String?
  picture            String?
  evolutionGroupId   String? // O JID do grupo
  instanceName       String? // O nome da instância da Evolution GO
  pictureUpdatedAt   DateTime? // Quando a foto foi baixada (URL do WhatsApp expira)
  participantCount   Int           @default(0)
  isAnnounce         Boolean       @default(false) // true = só admins falam
  isLocked           Boolean       @default(false) // true = só admins editam a info
  isApprovalRequired Boolean       @default(false)
  adminOnlyAdd       Boolean       @default(false)
  ownerPhone         String?
  topic              String?
  members            GroupMember[]
  schedules          Schedule[]
  messages           Message[]

  @@unique([instanceName, evolutionGroupId])
}

model GroupMember {
  id           String  @id @default(uuid())
  groupId      String
  phone        String // número real, sem sufixo (vem de Participants[].PhoneNumber)
  lid          String? // identificador anônimo do WhatsApp, quando existe
  displayName  String?
  isAdmin      Boolean @default(false)
  isSuperAdmin Boolean @default(false)
  role         String  @default("participant") // admin, participant
  group        Group   @relation(fields: [groupId], references: [id])

  @@index([groupId])
}

model Schedule {
  id                 String   @id @default(uuid())
  groupId            String
  type               String // text, media, button, poll, permission, profile
  content            String // JSON string
  scheduledAt        DateTime // Original requested time
  adjustedAt         DateTime // Adjusted time for anti-ban
  status             String   @default("pending") // pending, sent, skipped, deactivated, error, processing
  errorMessage       String?
  evolutionMessageId String?
  attempts           Int      @default(0)
  skipReason         String? // preenchido quando o grupo ja estava no estado pedido
  appliedInfo        String? // JSON com o que foi de fato aplicado
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id])
}

model Message {
  id        String   @id @default(uuid())
  groupId   String
  sender    String
  content   String // JSON or text
  timestamp DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])
}

/// Chave de API para acesso externo (REST e MCP).
/// Guardamos só o hash: a chave em texto aparece uma única vez, na criação.
model ApiKey {
  id         String    @id @default(uuid())
  name       String
  prefix     String    @unique // primeiros caracteres, para identificar na lista
  hash       String    @unique // sha256 da chave completa
  scopes     String    @default("read,write")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([revokedAt])
}

/// Um lote de edicao em massa. Guarda o estado anterior dos grupos para
/// permitir desfazer — a foto nao entra no snapshot, so nome e descricao.
model BulkEdit {
  id        String    @id @default(uuid())
  payload   String // JSON com o que foi pedido (template, descricao, foto)
  snapshot  String // JSON: [{groupId, name, topic}] antes da mudanca
  total     Int
  undoneAt  DateTime?
  createdAt DateTime  @default(now())
}

/// Link encurtado com contagem de cliques.
/// O destino real fica em `url`; o painel publica /l/{code}.
model TrackedLink {
  id         String      @id @default(uuid())
  code       String      @unique
  url        String
  label      String?
  groupId    String?
  scheduleId String?
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  clicks     LinkClick[]

  @@index([groupId])
}

model LinkClick {
  id        String      @id @default(uuid())
  linkId    String
  clickedAt DateTime    @default(now())
  userAgent String?
  referer   String?
  link      TrackedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, clickedAt])
}
